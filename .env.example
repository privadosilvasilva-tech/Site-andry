# Senha do painel do Andry (/admin). Se não definir, usa a senha padrão
# já configurada no código: pybHjWU/T3nv&jE
ADMIN_PASSWORD=pybHjWU/T3nv&jE

# Opcional: string usada para assinar o cookie de sessão do admin.
# Se não definir, usa a própria ADMIN_PASSWORD para assinar (funciona,
# mas defina algo próprio em produção para mais segurança).
ADMIN_SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# Preenchidos automaticamente pela Vercel quando você conecta um banco
# Vercel KV (Storage -> Create Database -> KV) ao projeto. Não precisa
# copiar manualmente se estiver usando a integração da Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
